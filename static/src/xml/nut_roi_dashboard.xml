<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="nut_tightening_monitor_v3.NtmLiveDashboard" owl="1">
        <div class="o_ntm_dashboard o_cpwi_mes_aligned">
            <header class="ntm_mes_header">
                <div class="ntm_mes_title">
                    <div class="ntm_mes_title_top">
                        <span class="ntm_mes_name">MANUFACTURING / FASTENING WORKSTATION</span>
                        <span t-att-class="'ntm_run_badge ntm_run_' + (state.assembly ? state.assembly.state : 'draft')" t-esc="cycleStatus"/>
                    </div>
                    <div class="ntm_mes_op">Nut Tightening Monitor <span class="ntm_header_sep">/</span> <strong t-esc="state.assemblyName || 'New Assembly Setup'"/></div>
                    <div class="ntm_mes_sub">Upload an assembly image, draw and number each nut ROI, then configure the robot/PLC position and tightening limits.</div>
                </div>
                <div class="ntm_header_actions">
                    <button class="ntm_btn ntm_btn_light" t-on-click="saveAssembly"><i class="fa fa-floppy-o"/> Save Mapping</button>
                    <button class="ntm_btn ntm_btn_green" t-on-click="() => runAction('action_start_cycle')" t-att-disabled="state.cycleBusy"><i class="fa fa-play"/> Start Cycle</button>
                    <button class="ntm_btn ntm_btn_amber" t-on-click="() => runAction('action_simulate_ok')" t-att-disabled="state.cycleBusy"><i class="fa fa-check"/> Simulate OK</button>
                    <button class="ntm_btn ntm_btn_red" t-on-click="() => runAction('action_simulate_nok')" t-att-disabled="state.cycleBusy"><i class="fa fa-times"/> Simulate NOK</button>
                    <button class="ntm_btn ntm_btn_light_outline" t-on-click="() => runAction('action_reset_cycle')" t-att-disabled="state.cycleBusy"><i class="fa fa-refresh"/> Reset</button>
                </div>
            </header>

            <section class="ntm_jobbar">
                <div class="ntm_job_field ntm_job_assembly">
                    <label for="ntm_assembly_select">Assembly Record</label>
                    <select id="ntm_assembly_select" class="form-select" t-on-change="onAssemblyChange">
                        <option value="">+ New assembly / upload new image</option>
                        <t t-foreach="state.assemblies" t-as="a" t-key="a.id">
                            <option t-att-value="a.id" t-att-selected="a.id === state.assemblyId"><t t-esc="a.reference"/> — <t t-esc="a.name"/></option>
                        </t>
                    </select>
                </div>
                <div class="ntm_job_field ntm_job_name">
                    <label for="ntm_assembly_name">Assembly Name</label>
                    <input id="ntm_assembly_name" class="form-control" type="text" placeholder="e.g. Motor Housing - Variant A" t-model="state.assemblyName"/>
                </div>
                <div class="ntm_job_field ntm_job_image">
                    <label for="ntm_image_file">Assembly Image</label>
                    <input id="ntm_image_file" class="form-control" type="file" accept="image/*" t-ref="imageFile" t-on-change="onImageSelected"/>
                    <small t-if="state.imageName" class="ntm_file_name"><i class="fa fa-picture-o"/> <t t-esc="state.imageName"/> <span t-if="state.imageWidth &amp;&amp; state.imageHeight">· <t t-esc="state.imageWidth"/> × <t t-esc="state.imageHeight"/> px</span></small>
                </div>
                <div class="ntm_job_hint"><span class="ntm_hint_icon"><i class="fa fa-info"/></span><span><strong>Operator workflow</strong><br/>Image → Draw circle → Assign nut ID → Set PLC/arm position → Set torque and angle → Save.</span></div>
            </section>

            <section class="ntm_kpis">
                <div class="ntm_kpi"><div class="ntm_kpi_label">Mapped Nuts</div><div class="ntm_kpi_value"><t t-esc="state.nuts.length"/><small> ROIs</small></div><div class="ntm_kpi_note">Defined on current image</div></div>
                <div class="ntm_kpi ntm_kpi_ok"><div class="ntm_kpi_label">Tightening OK</div><div class="ntm_kpi_value" t-esc="okCount"/><div class="ntm_kpi_note">Within configured limits</div></div>
                <div class="ntm_kpi ntm_kpi_nok"><div class="ntm_kpi_label">Tightening NOK</div><div class="ntm_kpi_value" t-esc="nokCount"/><div class="ntm_kpi_note">Torque or angle out of range</div></div>
                <div class="ntm_kpi"><div class="ntm_kpi_label">Pending / Current</div><div class="ntm_kpi_value" t-esc="pendingCount"/><div class="ntm_kpi_note">Awaiting tightening result</div></div>
                <div class="ntm_kpi ntm_kpi_progress"><div class="ntm_kpi_label">Cycle Completion</div><div class="ntm_kpi_value"><t t-esc="progress"/><small>%</small></div><div class="ntm_progress_track"><span t-att-style="'width:' + progress + '%'"/></div><div class="ntm_kpi_note"><t t-esc="okCount"/> of <t t-esc="state.nuts.length"/> nuts completed OK</div></div>
            </section>

            <main class="ntm_work_area">
                <section class="ntm_panel ntm_visual_panel">
                    <div class="ntm_panel_heading">
                        <div><span class="ntm_section_eyebrow">STEP 1</span><h2>Assembly Image / ROI Editor</h2><p>Draw each circle around the nut. Its ID and sequence are assigned as soon as you finish drawing.</p></div>
                        <div class="ntm_image_tools">
                            <button t-att-class="'ntm_tool_btn ' + (state.interactionMode === 'select' ? 'is_active' : '')" t-on-click="() => setInteractionMode('select')"><i class="fa fa-mouse-pointer"/> Select / Edit</button>
                            <button t-att-class="'ntm_tool_btn ntm_tool_primary ' + (state.interactionMode === 'draw' ? 'is_active' : '')" t-on-click="() => setInteractionMode('draw')"><i class="fa fa-circle-o"/> Draw ROI</button>
                            <button class="ntm_tool_btn ntm_tool_danger" t-on-click="removeSelectedNut" t-att-disabled="!selectedNut"><i class="fa fa-trash-o"/> Remove Selected</button>
                        </div>
                    </div>
                    <div t-att-class="'ntm_canvas_frame ' + (state.interactionMode === 'draw' ? 'ntm_canvas_drawing' : '')">
                        <canvas t-ref="roiCanvas" class="ntm_roi_canvas" width="1200" height="780"
                            t-on-pointerdown="onCanvasPointerDown" t-on-pointermove="onCanvasPointerMove" t-on-pointerup="onCanvasPointerUp" t-on-pointercancel="onCanvasPointerUp"/>
                        <div t-if="state.imageData &amp;&amp; state.interactionMode === 'draw'" class="ntm_canvas_instruction"><i class="fa fa-crosshairs"/> Click and drag to draw the nut circle</div>
                    </div>
                    <div class="ntm_visual_footer">
                        <div class="ntm_roi_steps"><span class="ntm_step_done"><i class="fa fa-check-circle"/> Upload image</span><span class="ntm_step_arrow">›</span><span t-att-class="state.nuts.length ? 'ntm_step_done' : 'ntm_step_current'"><i t-att-class="state.nuts.length ? 'fa fa-check-circle' : 'fa fa-circle-o'"/> Draw nut ROIs (<t t-esc="state.nuts.length"/>)</span><span class="ntm_step_arrow">›</span><span t-att-class="selectedNut ? 'ntm_step_current' : 'ntm_step_wait'"><i class="fa fa-sliders"/> Configure selected nut</span></div>
                        <div class="ntm_legend"><span><i class="ntm_legend_pending"/> Pending</span><span><i class="ntm_legend_current"/> Current sequence</span><span><i class="ntm_legend_ok"/> OK</span><span><i class="ntm_legend_nok"/> NOK</span></div>
                    </div>
                </section>

                <aside class="ntm_right_column">
                    <section class="ntm_panel ntm_sequence_panel">
                        <div class="ntm_panel_heading ntm_compact_heading"><div><span class="ntm_section_eyebrow">STEP 2</span><h2>Nut Sequence</h2></div><span class="ntm_count_pill"><t t-esc="state.nuts.length"/> mapped</span></div>
                        <div class="ntm_sequence_list">
                            <t t-foreach="state.nuts" t-as="n" t-key="n.id || n.name">
                                <button t-att-class="'ntm_sequence_row ' + (state.selectedIndex === state.nuts.indexOf(n) ? 'is_selected ' : '') + 'is_' + n.status" t-on-click="() => selectNut(state.nuts.indexOf(n))">
                                    <span class="ntm_sequence_number" t-esc="n.sequence"/>
                                    <span class="ntm_sequence_text"><strong t-esc="n.name"/><small><t t-esc="'Sequence ' + n.sequence"/> · <t t-esc="formatNumber(n.roi_x, 1)"/>, <t t-esc="formatNumber(n.roi_y, 1)"/> %</small></span>
                                    <span t-att-class="'ntm_status_pill status_' + n.status" t-esc="n.status === 'ok' ? 'OK' : n.status === 'nok' ? 'NOK' : n.status === 'running' ? 'CURRENT' : 'PENDING'"/>
                                </button>
                            </t>
                            <div t-if="!state.nuts.length" class="ntm_empty_state"><i class="fa fa-bullseye"/><strong>No nut ROIs yet</strong><span>Upload an image, press Draw ROI, and drag a circle around a nut.</span></div>
                        </div>
                    </section>

                    <section class="ntm_panel ntm_setup_panel">
                        <div class="ntm_panel_heading ntm_compact_heading"><div><span class="ntm_section_eyebrow">STEP 3</span><h2>Selected Nut Setup</h2></div><span t-if="selectedNut" class="ntm_selected_id" t-esc="selectedNut.name"/></div>
                        <t t-if="selectedNut">
                            <div class="ntm_setup_scroller">
                                <div class="ntm_form_section">
                                    <div class="ntm_form_section_title"><i class="fa fa-tag"/> Identification &amp; ROI</div>
                                    <div class="ntm_fields_grid">
                                        <label class="ntm_field ntm_field_wide"><span>Nut ID / Label</span><input class="form-control" type="text" t-att-value="selectedNut.name" t-on-change="ev => updateNut('name', ev)" placeholder="N-01"/></label>
                                        <label class="ntm_field"><span>Sequence order</span><input class="form-control" type="number" min="1" step="1" t-att-value="selectedNut.sequence" t-on-change="ev => updateNut('sequence', ev)"/></label>
                                        <label class="ntm_field"><span>ROI radius (%)</span><input class="form-control" type="number" min="0.5" max="20" step="0.1" t-att-value="selectedNut.roi_r" t-on-change="ev => updateNut('roi_r', ev)"/></label>
                                        <label class="ntm_field"><span>Centre X (%)</span><input class="form-control" type="number" min="0" max="100" step="0.1" t-att-value="selectedNut.roi_x" t-on-change="ev => updateNut('roi_x', ev)"/></label>
                                        <label class="ntm_field"><span>Centre Y (%)</span><input class="form-control" type="number" min="0" max="100" step="0.1" t-att-value="selectedNut.roi_y" t-on-change="ev => updateNut('roi_y', ev)"/></label>
                                    </div>
                                </div>
                                <div class="ntm_form_section">
                                    <div class="ntm_form_section_title"><i class="fa fa-crosshairs"/> PLC / Robot Arm Position</div>
                                    <div class="ntm_fields_grid">
                                        <label class="ntm_field"><span>Arm X (mm)</span><input class="form-control" type="number" step="0.001" t-att-value="selectedNut.arm_x" t-on-change="ev => updateNut('arm_x', ev)"/></label>
                                        <label class="ntm_field"><span>Arm Y (mm)</span><input class="form-control" type="number" step="0.001" t-att-value="selectedNut.arm_y" t-on-change="ev => updateNut('arm_y', ev)"/></label>
                                        <label class="ntm_field"><span>Arm Z (mm)</span><input class="form-control" type="number" step="0.001" t-att-value="selectedNut.arm_z" t-on-change="ev => updateNut('arm_z', ev)"/></label>
                                        <label class="ntm_field"><span>Encoder count</span><input class="form-control" type="number" step="1" t-att-value="selectedNut.encoder_position" t-on-change="ev => updateNut('encoder_position', ev)"/></label>
                                    </div>
                                    <div class="ntm_field_help"><i class="fa fa-info-circle"/> Example values are for simulation only. Enter calibrated PLC/arm coordinates when commissioning hardware.</div>
                                </div>
                                <div class="ntm_form_section">
                                    <div class="ntm_form_section_title"><i class="fa fa-tachometer"/> Torque Limits (Nm)</div>
                                    <div class="ntm_fields_grid ntm_three_fields">
                                        <label class="ntm_field"><span>Minimum</span><input class="form-control" type="number" step="0.01" t-att-value="selectedNut.torque_min" t-on-change="ev => updateNut('torque_min', ev)"/></label>
                                        <label class="ntm_field"><span>Target</span><input class="form-control" type="number" step="0.01" t-att-value="selectedNut.target_torque" t-on-change="ev => updateNut('target_torque', ev)"/></label>
                                        <label class="ntm_field"><span>Maximum</span><input class="form-control" type="number" step="0.01" t-att-value="selectedNut.torque_max" t-on-change="ev => updateNut('torque_max', ev)"/></label>
                                    </div>
                                </div>
                                <div class="ntm_form_section">
                                    <div class="ntm_form_section_title"><i class="fa fa-refresh"/> Angle Limits (degrees)</div>
                                    <div class="ntm_fields_grid ntm_three_fields">
                                        <label class="ntm_field"><span>Minimum</span><input class="form-control" type="number" step="0.1" t-att-value="selectedNut.angle_min" t-on-change="ev => updateNut('angle_min', ev)"/></label>
                                        <label class="ntm_field"><span>Target</span><input class="form-control" type="number" step="0.1" t-att-value="selectedNut.target_angle" t-on-change="ev => updateNut('target_angle', ev)"/></label>
                                        <label class="ntm_field"><span>Maximum</span><input class="form-control" type="number" step="0.1" t-att-value="selectedNut.angle_max" t-on-change="ev => updateNut('angle_max', ev)"/></label>
                                    </div>
                                </div>
                                <div class="ntm_live_result">
                                    <div><span>Last actual torque</span><strong><t t-esc="formatNumber(selectedNut.actual_torque || 0, 2)"/> Nm</strong></div>
                                    <div><span>Last actual angle</span><strong><t t-esc="formatNumber(selectedNut.actual_angle || 0, 1)"/>°</strong></div>
                                    <div><span>Last result</span><strong t-att-class="'result_' + selectedNut.status" t-esc="selectedNut.status.toUpperCase()"/></div>
                                    <p t-if="selectedNut.failure_reason" class="ntm_failure_reason"><i class="fa fa-exclamation-triangle"/> <t t-esc="selectedNut.failure_reason"/></p>
                                </div>
                            </div>
                            <div class="ntm_setup_footer"><span><i class="fa fa-check-circle"/> Changes are local until saved</span><button class="ntm_btn ntm_btn_primary" t-on-click="saveAssembly"><i class="fa fa-floppy-o"/> Save Mapping</button></div>
                        </t>
                        <div t-if="!selectedNut" class="ntm_setup_blank"><i class="fa fa-sliders"/><strong>Select or draw a nut</strong><span>After you draw a ROI, its ID, sequence, PLC position, torque and angle settings are edited here.</span></div>
                    </section>
                </aside>
            </main>

            <footer class="ntm_status_footer">
                <div class="ntm_footer_mode"><span class="ntm_sim_dot"/> <strong>SIMULATOR MODE</strong><span>No physical PLC connected</span></div>
                <div class="ntm_footer_message"><i class="fa fa-exchange"/> <t t-esc="currentMessage"/></div>
                <div class="ntm_footer_safety">For test use only — validate PLC coordinates and tightening limits before machine use.</div>
            </footer>
        </div>
    </t>
</templates>
