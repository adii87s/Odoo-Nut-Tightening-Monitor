<odoo>
    <record id="view_ntm_assembly_list" model="ir.ui.view">
        <field name="name">ntm.assembly.list</field>
        <field name="model">ntm.assembly</field>
        <field name="arch" type="xml">
            <list string="Nut Tightening Assemblies">
                <field name="reference"/>
                <field name="name"/>
                <field name="nut_count"/>
                <field name="done_count"/>
                <field name="failed_count"/>
                <field name="progress" widget="progressbar"/>
                <field name="state" widget="badge" decoration-success="state == 'pass'" decoration-danger="state == 'fail'" decoration-info="state == 'running'"/>
            </list>
        </field>
    </record>
    <record id="view_ntm_assembly_form" model="ir.ui.view">
        <field name="name">ntm.assembly.form</field>
        <field name="model">ntm.assembly</field>
        <field name="arch" type="xml">
            <form string="Nut Tightening Assembly">
                <header>
                    <button name="action_open_dashboard" type="object" string="Open ROI Dashboard" class="oe_highlight"/>
                    <button name="action_start_cycle" type="object" string="Start Cycle" class="oe_highlight" invisible="state == 'running'"/>
                    <button name="action_simulate_ok" type="object" string="Simulate OK" invisible="state != 'running'"/>
                    <button name="action_simulate_nok" type="object" string="Simulate NOK" invisible="state != 'running'"/>
                    <button name="action_simulate_random" type="object" string="Simulate Next Nut" invisible="state != 'running'"/>
                    <button name="action_reset_cycle" type="object" string="Reset Cycle"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,mapped,running,pass,fail"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <div class="oe_title"><h1><field name="name" placeholder="Assembly name"/></h1><div><field name="reference" readonly="1"/></div></div>
                    <group>
                        <group string="Assembly Image">
                            <field name="image" widget="image" options="{'preview_image': 'image'}" class="oe_avatar" style="width: 100%;"/>
                            <field name="image_filename" invisible="1"/>
                            <field name="image_mimetype" invisible="1"/>
                        </group>
                        <group string="Cycle Summary">
                            <field name="nut_count"/>
                            <field name="done_count"/>
                            <field name="failed_count"/>
                            <field name="pending_count"/>
                            <field name="progress" widget="progressbar"/>
                            <field name="active_nut_id"/>
                            <field name="last_plc_message"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Nut ROI &amp; PLC Mapping">
                            <field name="nut_ids" context="{'default_assembly_id': id}">
                                <list editable="bottom" decoration-success="status == 'ok'" decoration-danger="status == 'nok'">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="roi_x"/>
                                    <field name="roi_y"/>
                                    <field name="roi_r"/>
                                    <field name="arm_x"/>
                                    <field name="arm_y"/>
                                    <field name="arm_z"/>
                                    <field name="encoder_position"/>
                                    <field name="target_torque"/>
                                    <field name="torque_min"/>
                                    <field name="torque_max"/>
                                    <field name="target_angle"/>
                                    <field name="angle_min"/>
                                    <field name="angle_max"/>
                                    <field name="actual_torque" readonly="1"/>
                                    <field name="actual_angle" readonly="1"/>
                                    <field name="status" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Tightening History">
                            <field name="nut_ids" nolabel="1">
                                <list create="0" edit="0" delete="0">
                                    <field name="sequence"/>
                                    <field name="name"/>
                                    <field name="last_result"/>
                                    <field name="actual_torque"/>
                                    <field name="actual_angle"/>
                                    <field name="failure_reason"/>
                                    <field name="status" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_ntm_assemblies" model="ir.actions.act_window">
        <field name="name">Assembly Image &amp; Nut Mapping</field>
        <field name="res_model">ntm.assembly</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_ntm_root" name="Nut Tightening Monitor" sequence="35" groups="base.group_user"/>
    <menuitem id="menu_ntm_assemblies" name="Assemblies &amp; ROI Mapping" parent="menu_ntm_root" action="action_ntm_assemblies" sequence="10" groups="base.group_user"/>
    <record id="action_ntm_result" model="ir.actions.act_window">
        <field name="name">Tightening Results</field>
        <field name="res_model">ntm.result</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_ntm_results" name="Tightening History" parent="menu_ntm_root" action="action_ntm_result" sequence="20" groups="base.group_user"/>
</odoo>
